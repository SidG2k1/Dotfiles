# Commit signing is deliberately NOT configured here. It needs a signer binary
# at a machine-specific path and a key that only that machine has, and on a
# managed Mac the provider is chosen by MDM rather than by this repo. Setting
# commit.gpgsign here would make every commit fail on any machine that does not
# happen to match. Configure signing per machine in ~/.gitconfig.local.
#
# [user] is deliberately absent for the same reason. ~/.gitconfig includes this
# file and then ~/.gitconfig.local, so anything set here WINS over the name and
# email the machine already had - a symlink is not the only way to overwrite an
# identity. Name and email belong in ~/.gitconfig.local, which is untracked.
[alias]
	co = checkout
	st = status
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = default
