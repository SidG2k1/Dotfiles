[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
# [user] is deliberately absent. ~/.gitconfig includes this file and then
# ~/.gitconfig.local, so anything set here WINS over the name/email the machine
# already had - a symlink is not the only way to overwrite an identity. Name,
# email and signingkey belong in ~/.gitconfig.local, which is untracked.
[alias]
	co = checkout
	st = status
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
	updateRefs = true
[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = default
