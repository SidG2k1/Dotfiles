#!/usr/bin/env bash
# rebuild-alttab — build and install the pinned AltTab source build.
#
# Encodes the procedure documented in setup.md ("Pinned AltTab source build")
# so it is runnable and verifiable instead of copy-pasted.
#
# The build is pinned to v10.12.0 (commit 317a485b), before AltTab's Pro
# subsystem and source-tree restructure, and Sparkle auto-updates are patched
# off in three places so a stale user default cannot re-enable them. It is
# ad-hoc signed and NOT notarized, so `spctl` may reject it even when local
# launch works fine.
#
# Usage:
#   rebuild-alttab check         prerequisites + patch state, no build (safe)
#   rebuild-alttab build         build, sign, install to /Applications, launch
#   rebuild-alttab reset-perms   re-grant flow after a rebuild loses TCC state
#
# Override the checkout location with ALTTAB_SRC.

set -euo pipefail

SRC="${ALTTAB_SRC:-$HOME/src/alt-tab-macos}"
PIN=317a485bcb090bf2b29e3f78872218f0099e1d62
BUNDLE_ID=com.lwouis.alt-tab-macos
APP=/Applications/AltTab.app
BUILT="$SRC/DerivedData/Build/Products/Debug/AltTab.app"

note() { printf '==> %s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

check_xcode() {
  local dev
  dev=$(xcode-select -p 2>/dev/null || true)
  case "$dev" in
    */CommandLineTools|"")
      die "full Xcode required, active developer dir is '${dev:-none}'.
  Install Xcode (App Store, or 'brew install --cask xcodes-app'), then:
      sudo xcode-select -s /Applications/Xcode.app/Contents/Developer
      sudo xcodebuild -license accept
      sudo xcodebuild -runFirstLaunch" ;;
  esac
  command -v xcodebuild >/dev/null || die "xcodebuild not on PATH"
  note "Xcode: $(xcodebuild -version | head -1) (developer dir: $dev)"
}

check_src() {
  [ -d "$SRC/.git" ] || die "no checkout at $SRC
  git clone https://github.com/lwouis/alt-tab-macos.git \"$SRC\"
  git -C \"$SRC\" switch -c pre-pro $PIN"
  # The working tree must descend from the pinned commit; HEAD itself will
  # differ because the Sparkle patches are uncommitted local edits.
  git -C "$SRC" merge-base --is-ancestor "$PIN" HEAD 2>/dev/null \
    || die "HEAD in $SRC is not a descendant of the pinned commit $PIN"
  note "checkout: $(git -C "$SRC" rev-parse --abbrev-ref HEAD) @ $(git -C "$SRC" rev-parse --short HEAD)"
}

check_patches() {
  local bad=0
  grep -A1 'SUEnableAutomaticChecks' "$SRC/Info.plist" | grep -q '<string>false</string>' \
    || { warn "Info.plist: SUEnableAutomaticChecks is not false"; bad=1; }
  grep -q 'UpdatePolicyPreference.manual.indexAsString' "$SRC/src/logic/Preferences.swift" \
    || { warn "Preferences.swift: default updatePolicy is not .manual"; bad=1; }
  grep -q 'automaticallyDownloadsUpdates = false' "$SRC/src/logic/events/PreferencesEvents.swift" \
    && grep -q 'automaticallyChecksForUpdates = false' "$SRC/src/logic/events/PreferencesEvents.swift" \
    || { warn "PreferencesEvents.swift: Sparkle flags are not both forced false"; bad=1; }
  [ "$bad" -eq 0 ] || die "Sparkle patches missing — see setup.md before building"
  note "Sparkle patches: all three present"

  # Not part of setup.md's three sites. UserDefaultsEvents observes the Sparkle
  # user defaults and can set automaticallyChecksForUpdates = true, but only
  # when automaticallyDownloadsUpdates is already true, which the patches above
  # force false. Reachable only from a stale default before the first
  # applyUpdatePolicyPreference() call. Reported, not patched.
  if grep -q 'automaticallyChecksForUpdates = true' "$SRC/src/logic/events/UserDefaultsEvents.swift" 2>/dev/null; then
    warn "UserDefaultsEvents.swift still has a re-enable path (expected; see comment in this script)"
  fi
}

do_build() {
  check_xcode; check_src; check_patches
  note "building (workspace, not project — the project alone won't resolve Pods)"
  ( cd "$SRC" && xcodebuild \
      -workspace alt-tab-macos.xcworkspace \
      -scheme Debug \
      -configuration Debug \
      -derivedDataPath DerivedData \
      CODE_SIGNING_ALLOWED=NO \
      CODE_SIGNING_REQUIRED=NO \
      build )
  [ -d "$BUILT" ] || die "build reported success but $BUILT is missing"

  note "ad-hoc signing"
  codesign --force --deep --sign - "$BUILT"
  codesign --verify --deep --strict --verbose=2 "$BUILT"

  note "installing to $APP"
  killall AltTab 2>/dev/null || true
  rsync -a --delete "$BUILT/" "$APP/" \
    || die "rsync to $APP failed — retry with sudo if /Applications is not writable"

  open "$APP"
  note "launched. Not notarized: 'spctl -a' may still reject it."
  note "If macOS shows stale permissions, run: $(basename "$0") reset-perms"
}

do_reset_perms() {
  note "resetting TCC state for $BUNDLE_ID"
  killall AltTab 2>/dev/null || true
  tccutil reset ScreenCapture "$BUNDLE_ID" || warn "ScreenCapture reset failed"
  tccutil reset Accessibility "$BUNDLE_ID" || warn "Accessibility reset failed"
  open "$APP"
  cat <<'EOF'
==> Now grant both, by hand (GUI only — cannot be scripted):
      System Settings > Privacy & Security > Screen & System Audio Recording
      System Settings > Privacy & Security > Accessibility
    If approval still isn't detected, remove and re-add /Applications/AltTab.app
    in both lists.
EOF
}

case "${1:-build}" in
  check)       check_src; check_patches
               dev=$(xcode-select -p 2>/dev/null || echo none)
               case "$dev" in */CommandLineTools|none)
                 warn "full Xcode not active (developer dir: $dev) — 'build' will refuse" ;;
                 *) note "Xcode OK: $dev" ;;
               esac ;;
  build)       do_build ;;
  reset-perms) do_reset_perms ;;
  *)           die "usage: $(basename "$0") {check|build|reset-perms}" ;;
esac
